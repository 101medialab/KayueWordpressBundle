{
    "name": "kayue/kayue-wordpress-bundle",
    "type": "symfony-bundle",
    "description": "Integrates WordPress data into Symfony via Doctrine ORM.",
    "keywords": [
        "authentication", "firewall", "wordpress", "symfony", "security", "doctrine"
    ],
    "homepage": "https://github.com/kayue/KayueWordpressBundle",
    "license": "MIT",

    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^5.4",
        "symfony/security-bundle": "^5.4",
        "symfony/password-hasher": "^5.4",
        "symfony/cache": "^5.4",
        "doctrine/orm": "^2.14",
        "doctrine/dbal": "^2.13",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kayue\\WordpressBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kayue\\WordpressBundle\\Tests\\": "Tests/"
        }
    }
}
